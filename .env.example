# Copy to .env.local and fill in from Supabase → Project Settings → API keys.
# Only the browser-safe *publishable* key belongs here. Never put the secret / service_role key in this app.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
